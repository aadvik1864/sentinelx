ENVIRONMENT=development
JWT_SECRET=
MFA_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# Separate production-only identities; never deliver bootstrap/migration secrets to the API.
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_NOTIFICATION_PASSWORD=
REDIS_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@sentinelx.dev
BOOTSTRAP_ADMIN_PASSWORD=
DEMO_MODE=true
SEED_DEMO=true
LIVE_MONITORING=false
# Optional separate database for real monitoring; existing demo data is retained.
POSTGRES_DATABASE=sentinelx
COOKIE_SECURE=false
# Explicit development-only opt-in; never enable this for shared/production deployments.
API_DOCS_ENABLED=false
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
# auto keeps offline summaries unless an external key is configured.
# Free local AI: LLM_PROVIDER=ollama; start the local-ai Compose profile and pull the model.
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:1.7b
LLM_TIMEOUT_SECONDS=180
# Optional external OpenAI-compatible service (may charge fees).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional authorized AbuseIPDB account; no fabricated reputation when absent.
ABUSEIPDB_API_KEY=
# Production external traffic is denied unless the controlled-egress overlay is approved.
EGRESS_PROXY_PASSWORD=
EGRESS_ALLOWED_HOSTS=api.openai.com,api.abuseipdb.com
