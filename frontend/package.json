    "@tailwindcss/vite": "^4.1.4",
    "@xyflow/react": "^12.6.0",
    "axios": "^1.8.4",
    "lucide-react": "^0.468.0",
    "motion": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.1",
    "recharts": "^2.15.3",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
